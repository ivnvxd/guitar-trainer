[Unit]
Description=Guitar Trainer: the sound of a YouTube video for Slow down
After=network-online.target
Wants=network-online.target

[Service]
# GT_KEY=... is in this file, and GT_ORIGIN or GT_PORT if you change them.
EnvironmentFile=/etc/guitar-ytdl.env
# yt-dlp needs deno. Both must be in one of these folders.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=XDG_CACHE_HOME=/var/cache/guitar-ytdl
Environment=DENO_DIR=/var/cache/guitar-ytdl/deno
Environment=HOME=/var/cache/guitar-ytdl
ExecStart=/usr/bin/python3 /opt/guitar-ytdl/ytdl.py
Restart=on-failure
# A user without rights, made for this service only.
DynamicUser=yes
CacheDirectory=guitar-ytdl
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
